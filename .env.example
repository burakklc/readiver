# Safe to expose in browser and mobile clients. Access is still governed by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose these values through NEXT_PUBLIC_* or iOS configuration.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ANONYMOUS_RATE_LIMIT_MAX_REQUESTS=20
ANONYMOUS_RATE_LIMIT_WINDOW_SECONDS=86400
