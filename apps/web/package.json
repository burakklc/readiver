{
  "name": "@readiver/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:backend && npm run test:evals && npm run test:web",
    "test:backend": "node --test --experimental-strip-types ../../supabase/functions/adapt/*.test.ts",
    "test:evals": "node --test --experimental-strip-types ../../evals/adaptation-quality/*.test.ts",
    "test:web": "vitest run",
    "eval:quality": "node --experimental-strip-types ../../evals/adaptation-quality/run.ts",
    "eval:review": "node --experimental-strip-types ../../evals/adaptation-quality/review-cli.ts"
  },
  "dependencies": {
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
